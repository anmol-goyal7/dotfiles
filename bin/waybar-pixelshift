#!/usr/bin/env bash
# waybar-pixelshift — nudge waybar's contents a few pixels on a timer, so the
# clock, the tray icons and the workspace numbers do not sit on the exact same
# OLED subpixels for an entire uptime. Same idea as the pixel-shift a TV does.
#
#   waybar-pixelshift              run forever, shifting every 10 min
#   waybar-pixelshift 120          ... every 120s
#   waybar-pixelshift --once       write one offset and exit (used by install.sh)
#   waybar-pixelshift --reset      zero the offset and exit
#
# Started from hypr/UserConfigs/Startup_Apps.conf. Panel is a Samsung ATNA40YK11.
#
# How it moves things, and why it looks this way -- all four points measured on
# waybar 0.15.0 rather than assumed:
#
#   * `window#waybar > box { margin-* }` is the lever that actually works. It
#     shifts every module group at once. `window#waybar { padding-* }` looks
#     like it should do the same job and is silently a no-op.
#   * waybar watches ONLY ~/.config/waybar/style.css. It does not watch files
#     that stylesheet @imports, and it ignores a bare `touch` -- the watcher
#     wants a real write. So after rewriting shift.css we rewrite style.css
#     with byte-identical content purely to trip the watcher. Identical bytes
#     means `git status` stays clean, which is the whole point of the dance.
#   * that reload path (`reload_style_on_change`) is flash-free. Reloading with
#     SIGUSR2 instead repaints the bar GTK-default grey for a frame, which on a
#     black OLED bar is both ugly and exactly the wrong direction.
#   * shift.css MUST exist. GTK throws away the entire stylesheet if an @import
#     target is missing, and the bar drops to unstyled grey -- so we recreate it
#     on every tick rather than assuming it survived.
#
# Offsets are deliberately tiny (0-3px across, 0-2px down) and fit inside the
# module margins the theme already has, so nothing clips or reflows.

set -u

STYLE="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/style.css"
SHIFT="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/shift.css"
INTERVAL="${WAYBAR_PIXELSHIFT_INTERVAL:-600}"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/waybar-pixelshift.lock"

# 12 positions. L is the only free horizontal value: margin-right is 3-L, which
# keeps the box the same width and walks the left group right, the right group
# left, and the centre (the clock) by half of each -- so every group travels.
# Same trick vertically with V and 2-V.
H_SPAN=3
V_SPAN=2

write_shift() { # $1=L  $2=V
    local l=$1 v=$2 r=$((H_SPAN - $1)) b=$((V_SPAN - $2))
    cat > "$SHIFT" <<EOF
/* generated by waybar-pixelshift — do not edit, not tracked by git.
   Offset ${l},${v}. style.css @imports this; if it goes missing GTK drops the
   whole stylesheet and the bar turns grey, so the daemon rewrites it every tick. */
window#waybar > box {
  margin-left: ${l}px;
  margin-right: ${r}px;
  margin-top: ${v}px;
  margin-bottom: ${b}px;
}
EOF
}

# Rewrite style.css with its own bytes to trip waybar's file watcher.
# Skipped while the file is being edited: if he just saved it, his own save
# already triggered the reload, and writing a copy we read a moment earlier
# could clobber it. The shift simply resumes on the next tick.
poke_style() {
    local tmp mtime_before mtime_after age now
    [[ -f $STYLE ]] || return 0

    now=$(date +%s)
    mtime_before=$(stat -c %Y "$STYLE" 2>/dev/null) || return 0
    age=$((now - mtime_before))
    ((age < 30)) && return 0          # actively being edited — leave it alone

    tmp=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/waybar-style.XXXXXX") || return 0
    cp -- "$STYLE" "$tmp"
    mtime_after=$(stat -c %Y "$STYLE" 2>/dev/null)
    if [[ $mtime_before == "$mtime_after" ]]; then
        # conv=notrunc: identical length, so the file is never briefly truncated
        dd if="$tmp" of="$STYLE" conv=notrunc status=none 2>/dev/null
    fi
    rm -f -- "$tmp"
}

apply() { write_shift "$1" "$2"; poke_style; }

case "${1:-}" in
    --once)  apply 0 0; exit 0 ;;
    --reset) apply 0 0; exit 0 ;;
    --help|-h) sed -n '2,8p' "$0" | sed 's/^# \?//'; exit 0 ;;
    ''|*[!0-9]*) : ;;                # no arg, or not a number — keep default
    *) INTERVAL="$1" ;;
esac

# One shifter per session; re-running Startup_Apps must not stack them.
exec 9>"$LOCK"
flock -n 9 || { echo "waybar-pixelshift: already running" >&2; exit 0; }

i=0
while :; do
    apply "$((i % (H_SPAN + 1)))" "$(((i / (H_SPAN + 1)) % (V_SPAN + 1)))"
    i=$(((i + 1) % ((H_SPAN + 1) * (V_SPAN + 1))))
    sleep "$INTERVAL"
done
