#!/usr/bin/env bash
# zen — lock-in focus mode (Super+F5).
#
#   zen           toggle the mode
#   zen on        enter
#   zen off       leave
#   zen status    print "on <title>" or "off"
#
# This is a lock, not a nudge. While it is on you are held in the one window
# you started it from: you cannot open another window, tab, app or workspace,
# and you cannot move or resize what you are working in.
#
# Two mechanisms, because either alone leaks:
#
#   1. A `zen` submap. Entering a submap makes every global bind inactive at
#      once — launchers, workspace switching, movement, the lot — instead of
#      unbinding them one at a time. Only what this script re-declares inside
#      the submap still works: Super+F5 to leave, the XF86 hardware keys
#      (volume, brightness, media, mic) and the lock-screen bind. Leaving is
#      `submap reset` + `hyprctl reload config-only`, which re-reads every bind
#      from the config files, so a botched submap cannot strand you. Hyprland
#      re-reads its config whenever a config file changes, which would empty
#      the submap and leave no way out at all, so the watcher rebuilds it on
#      every `configreloaded`.
#
#   2. A focus watcher on Hyprland's event socket. Keybinds are only half the
#      problem — a click on another window, or an app popping one open, would
#      still move you. The watcher snaps focus straight back to the locked
#      window, which also drags you back from another workspace, since
#      `focuswindow` follows the window. It stands down on its own if the
#      locked window is closed, so quitting the app cannot leave you trapped.
#
# Keys the compositor cannot see the meaning of get swallowed by binding them
# to a no-op inside the submap. Ctrl+Shift+T/N (new tab, new window in both a
# browser and kitty) and Alt+Tab go always; the plain Ctrl+T/N/L/Tab/1-9 group
# only when the locked window is a browser, because in a terminal those are
# work keys — Ctrl+L clears the screen, Ctrl+N completes in nvim, Ctrl+T is
# fzf.
#
# That reload is also why leaving zen used to take the red tint and the current
# power mode down with it: it re-reads the config files, and both of those live
# only at runtime. Zen snapshots them on the way out and puts them back.
#
# Notifications go quiet through swaync do-not-disturb. Critical ones still
# come through (swaync 0.12.6), which is how the low battery warning stays
# visible — see bin/battery-low-warning.

set -u

STATE="${XDG_RUNTIME_DIR:-/tmp}/zen-mode.state"
WATCHPID="${XDG_RUNTIME_DIR:-/tmp}/zen-watch.pid"
BORDER='rgba(bb9af7ff)'
SELF=$(readlink -f "$0")
BROWSERS='brave|chrome|chromium|firefox|vivaldi|opera|edge|qutebrowser'
# Options the power-mode scripts set at runtime and no config file mentions.
# `hyprctl reload` re-reads those files, so leaving zen used to hand blur and
# animations back to the config and quietly undo saver or game mode.
PRESERVE=(animations:enabled decoration:blur:enabled)

need_hypr() {
    if ! command -v hyprctl >/dev/null || [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
        echo "zen: needs a running Hyprland session" >&2
        exit 1
    fi
}

note() { command -v notify-send >/dev/null && notify-send -a zen "$@" >/dev/null 2>&1 || true; }

# The red tint is lost to a reload the same way, but bin/red owns that one, so
# ask it to put itself back rather than snapshotting the shader here too.
# By path, not by name: a Hyprland bind does not run under his shell's PATH.
red() { "${SELF%/*}/red" "$1" >/dev/null 2>&1 || true; }

opt_get() {
    hyprctl getoption "$1" -j 2>/dev/null |
        jq -r '(.str // .int // .float // .custom // "") | tostring'
}

# "<option>\t<value>" a line, which is also how they sit in the state file.
snapshot_opts() {
    local o
    for o in "${PRESERVE[@]}"; do
        printf '%s\t%s\n' "$o" "$(opt_get "$o")"
    done
}

# Reads that back from stdin and puts back only what the reload actually moved.
restore_opts() {
    local o want
    while IFS=$'\t' read -r o want; do
        [[ -n $o && -n $want ]] || continue
        [[ $(opt_get "$o") == "$want" ]] && continue
        hyprctl keyword "$o" "$want" >/dev/null
    done
}

# The binds worth keeping inside the lock: hardware keys, which are not a way
# to get distracted, and the lock screen. Read from the live config rather than
# retyped here, so they stay correct if he re-binds them.
carry_binds() {
    hyprctl binds -j | jq -r '
      def modstr($m): [
        {b:1,n:"SHIFT"},{b:2,n:"CAPS"},{b:4,n:"CTRL"},{b:8,n:"ALT"},
        {b:16,n:"MOD2"},{b:32,n:"MOD3"},{b:64,n:"SUPER"},{b:128,n:"MOD5"}
      ] | map(select((($m / .b) | floor) % 2 == 1) | .n) | join(" ");

      .[] | select(.submap == "")
      | select((.key | test("^xf86"; "i")) or (.arg | test("LockScreen|hyprlock")))
      | ((if .locked then "l" else "" end) + (if .release then "r" else "" end)
        + (if .repeat then "e" else "" end) + (if .mouse then "m" else "" end)
        + (if .non_consuming then "n" else "" end))                as $flags
      | (if .keycode != 0 then "code:\(.keycode)" else .key end)    as $key
      | [ "bind\($flags)",
          "\(modstr(.modmask)), \($key), \(.dispatcher)"
            + (if .arg == "" then "" else ", \(.arg)" end)
        ] | @tsv'
}

build_submap() {
    local class=$1 kw value key

    hyprctl keyword submap zen >/dev/null

    # The way out. Nothing else may launch, focus or move anything.
    hyprctl keyword bind "SUPER, F5, exec, $SELF" >/dev/null
    # Keyword and value must go as two arguments. Folded into one, the "=" is
    # read as the first modifier and the bind is dropped — silently, when the
    # mod list is non-empty enough to hide it.
    while IFS=$'\t' read -r kw value; do
        [[ -n $kw ]] && hyprctl keyword "$kw" "$value" >/dev/null
    done < <(carry_binds)

    # Swallowed keys. `submap, zen` re-enters the submap already active, so it
    # consumes the key and does nothing — no process spawned per keypress.
    for key in "CTRL SHIFT, T" "CTRL SHIFT, N" "ALT, Tab"; do
        hyprctl keyword bind "$key, submap, zen" >/dev/null
    done

    if [[ $class =~ ^($BROWSERS) ]]; then
        for key in "CTRL, T" "CTRL, N" "CTRL, L" "CTRL, Tab" "CTRL SHIFT, Tab" \
            "CTRL, prior" "CTRL, next" \
            "CTRL, code:10" "CTRL, code:11" "CTRL, code:12" "CTRL, code:13" \
            "CTRL, code:14" "CTRL, code:15" "CTRL, code:16" "CTRL, code:17" \
            "CTRL, code:18"; do
            hyprctl keyword bind "$key, submap, zen" >/dev/null
        done
    fi

    hyprctl keyword submap reset >/dev/null
}

# Snaps focus back to the locked window. Runs detached; `zen off` kills it.
watch_focus() {
    echo $$ >"$WATCHPID"
    exec python3 - "$1" "$SELF" <<'PY'
import os, socket, subprocess, sys, time

locked, zen = sys.argv[1], sys.argv[2]
short = locked[2:] if locked.startswith("0x") else locked

path = os.path.join(os.environ["XDG_RUNTIME_DIR"], "hypr",
                    os.environ["HYPRLAND_INSTANCE_SIGNATURE"], ".socket2.sock")
sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.connect(path)

recent, buf = [], b""
while True:
    data = sock.recv(4096)
    if not data:
        break
    buf += data
    while b"\n" in buf:
        raw, buf = buf.split(b"\n", 1)
        event, _, arg = raw.decode("utf-8", "replace").partition(">>")
        arg = arg.strip()
        if arg.startswith("0x"):
            arg = arg[2:]

        # The window went away — release the lock rather than trap him in a
        # mode whose anchor no longer exists. Detached, so `zen off` killing
        # this process cannot leave the release half-done.
        if event == "closewindow" and arg == short:
            subprocess.Popen([zen, "off"], start_new_session=True)
            sys.exit(0)

        # A reload wiped the submap out from under us; put it back.
        if event == "configreloaded":
            time.sleep(0.3)
            subprocess.run([zen, "__rearm", locked],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            continue

        if event == "activewindowv2" and arg != short:
            # Always pull focus back — never skip one, or a steal would stick.
            # The backoff only exists so a window fighting for focus cannot
            # turn this into a spin.
            now = time.monotonic()
            recent = [t for t in recent if now - t < 2.0]
            if len(recent) >= 30:
                time.sleep(0.5)
                recent.clear()
            recent.append(now)
            subprocess.run(["hyprctl", "dispatch", "focuswindow",
                            "address:" + locked],
                           stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
PY
}

# Hyprland re-reads its config whenever a config file changes, which throws
# away a submap built at runtime. Left alone that is a lockout: the compositor
# would still be *in* the zen submap, but with nothing bound in it — not even
# the way out. The watcher calls this back on every `configreloaded`.
rearm() {
    local addr=$1 class n

    # zen is being torn down (`zen off` removes the state before it reloads);
    # rebuilding here would fight the release.
    [[ -r $STATE ]] || return 0

    n=$(hyprctl binds -j | jq '[.[] | select(.submap == "zen")] | length')
    if ((n == 0)); then
        class=$(hyprctl clients -j | jq -r --arg a "$addr" \
            'first(.[] | select(.address == $a) | .class) // ""')
        build_submap "$class"
    fi
    hyprctl --batch "keyword unbind SUPER, mouse:272 ; keyword unbind SUPER, mouse:273" >/dev/null
    hyprctl keyword general:col.active_border "$BORDER" >/dev/null
    hyprctl dispatch submap zen >/dev/null

    # The reload that got us here flattened the runtime settings as well. Their
    # live values are already gone, so the snapshot zen took on the way in is
    # all there is to go on.
    { read -r _; read -r _; read -r _; restore_opts; } <"$STATE" 2>/dev/null || true
    red reapply
}

zen_on() {
    if [[ -r $STATE ]]; then
        echo "zen: already on" >&2
        return 0
    fi

    local win addr title class dnd pid
    win=$(hyprctl activewindow -j)
    addr=$(jq -r '.address // ""' <<<"$win")
    title=$(jq -r '.title // ""' <<<"$win")
    class=$(jq -r '.class // ""' <<<"$win")

    if [[ -z $addr || $addr == null ]]; then
        note "zen" "focus a window first — there is nothing to lock onto"
        echo "zen: no focused window to lock" >&2
        return 1
    fi

    dnd=$(swaync-client -D 2>/dev/null || echo false)
    note "zen on" "locked to $title"

    build_submap "$class"
    # Belt and braces: the submap already makes these inactive, but the mouse
    # drag binds are the one path that needs no keyboard at all.
    hyprctl --batch "keyword unbind SUPER, mouse:272 ; keyword unbind SUPER, mouse:273" >/dev/null
    hyprctl keyword general:col.active_border "$BORDER" >/dev/null
    hyprctl dispatch submap zen >/dev/null

    rm -f "$WATCHPID"
    setsid -f "$SELF" __watch "$addr" >/dev/null 2>&1

    command -v swaync-client >/dev/null && swaync-client -dn >/dev/null 2>&1
    { printf '%s\n%s\n%s\n' "$addr" "$dnd" "$title"; snapshot_opts; } >"$STATE"
}

zen_off() {
    if [[ ! -r $STATE ]]; then
        echo "zen: not on" >&2
        return 0
    fi

    local addr dnd title pid snap
    { read -r addr; read -r dnd; read -r title; } <"$STATE" || true
    # Taken live rather than from the state file, so a mode he switched during
    # zen is the one that survives leaving it.
    snap=$(snapshot_opts)
    rm -f "$STATE"

    # Checked against its cmdline first, so a recycled pid is never the one
    # that gets killed.
    if [[ -r $WATCHPID ]]; then
        read -r pid <"$WATCHPID"
        if [[ -n ${pid:-} ]] && grep -qa "$SELF" "/proc/$pid/cmdline" 2>/dev/null; then
            kill "$pid" 2>/dev/null
        fi
        rm -f "$WATCHPID"
    fi

    hyprctl dispatch submap reset >/dev/null
    # Re-reads the binds and the border colour from the config files, and drops
    # the submap this script built along the way.
    hyprctl reload config-only >/dev/null
    restore_opts <<<"$snap"
    red reapply

    # Only lift do-not-disturb if zen was what turned it on — dsa mode and pomo
    # use it too, and one of them may still be running.
    if [[ ${dnd:-false} != true ]] && command -v swaync-client >/dev/null; then
        swaync-client -df >/dev/null 2>&1
    fi

    note "zen off" "unlocked"
}

status() {
    if [[ -r $STATE ]]; then
        local addr dnd title
        { read -r addr; read -r dnd; read -r title; } <"$STATE" || true
        echo "on ${title:-?}"
    else
        echo "off"
    fi
}

case ${1:-} in
    '')       need_hypr; if [[ -r $STATE ]]; then zen_off; else zen_on; fi ;;
    on)       need_hypr; zen_on ;;
    off)      need_hypr; zen_off ;;
    status)   status ;;
    __watch)  watch_focus "${2:?}" ;;
    __rearm)  rearm "${2:?}" ;;
    *)        echo "usage: zen [on|off|status]" >&2; exit 2 ;;
esac
