#!/usr/bin/env bash
# zen — lock-in focus mode (Super+F5).
#
#   zen           toggle the mode
#   zen on        enter
#   zen off       leave
#   zen status    print "on <title>" or "off"
#
# This is a lock, not a nudge. While it is on you are held in the one window
# you started it from: you cannot open another window, tab, app or workspace,
# and you cannot move or resize what you are working in.
#
# Two mechanisms, because either alone leaks:
#
#   1. A `zen` submap. Entering a submap makes every global bind inactive at
#      once — launchers, workspace switching, movement, the lot — instead of
#      unbinding them one at a time. Only what the submap declares still works:
#      Super+F5 to leave, the hardware keys (volume, brightness, media, mic)
#      and the lock-screen bind.
#
#      The submap itself is declared in the config, in hypr/lua/submaps.lua,
#      not built here. That is what makes it survive a reload: Hyprland
#      re-reads the config whenever a file under hypr/ changes, and under the
#      old .conf setup the submap was assembled at runtime with `hyprctl
#      keyword`, so a reload emptied it — the compositor stayed *in* the zen
#      submap with nothing bound in it, not even the way out. Now a reload
#      rebuilds it from the config. What a reload does still drop is the
#      runtime half — border colour, the mouse-drag unbinds, the browser keys —
#      and ZEN_ARM puts those back; the watcher calls it on configreloaded.
#
#   2. A focus watcher on Hyprland's event socket. Keybinds are only half the
#      problem — a click on another window, or an app popping one open, would
#      still move you. The watcher snaps focus straight back to the locked
#      window, which also drags you back from another workspace, since
#      focusing follows the window. It stands down on its own if the locked
#      window is closed, so quitting the app cannot leave you trapped.
#
# Keys the compositor cannot see the meaning of get swallowed by binding them
# to a no-op inside the submap. Ctrl+Shift+T/N (new tab, new window in both a
# browser and kitty) and Alt+Tab go always; the plain Ctrl+T/N/L/Tab/1-9 group
# only when the locked window is a browser, because in a terminal those are
# work keys — Ctrl+L clears the screen, Ctrl+N completes in nvim, Ctrl+T is
# fzf. See ZEN_SWALLOW / ZEN_SWALLOW_BROWSER in hypr/lua/submaps.lua.
#
# Leaving is `submap reset` + `hyprctl reload config-only`. That reload is also
# why leaving zen used to take the red tint and the current power mode down
# with it: it re-reads the config, and both of those live only at runtime. Zen
# snapshots them on the way out and puts them back.
#
# Notifications go quiet through swaync do-not-disturb. Critical ones still
# come through (swaync 0.12.6), which is how the low battery warning stays
# visible — see bin/battery-low-warning.

set -u

STATE="${XDG_RUNTIME_DIR:-/tmp}/zen-mode.state"
WATCHPID="${XDG_RUNTIME_DIR:-/tmp}/zen-watch.pid"
SELF=$(readlink -f "$0")
BROWSERS='brave|chrome|chromium|firefox|vivaldi|opera|edge|qutebrowser'
# Options the power-mode scripts set at runtime and no config file mentions.
# `hyprctl reload` re-reads the config, so leaving zen used to hand blur and
# animations back to it and quietly undo saver or game mode.
PRESERVE=(animations:enabled decoration:blur:enabled)

# By path, not by name: a Hyprland bind does not run under his shell's PATH.
HLSET="${SELF%/*}/hlset"

need_hypr() {
    if ! command -v hyprctl >/dev/null || [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
        echo "zen: needs a running Hyprland session" >&2
        exit 1
    fi
}

note() { command -v notify-send >/dev/null && notify-send -a zen "$@" >/dev/null 2>&1 || true; }

# The red tint is lost to a reload the same way, but bin/red owns that one, so
# ask it to put itself back rather than snapshotting the shader here too.
red() { "${SELF%/*}/red" "$1" >/dev/null 2>&1 || true; }

opt_get() {
    hyprctl getoption "$1" -j 2>/dev/null |
        jq -r '(.str // .int // .float // .custom // "") | tostring'
}

# "<option>\t<value>" a line, which is also how they sit in the state file.
snapshot_opts() {
    local o
    for o in "${PRESERVE[@]}"; do
        printf '%s\t%s\n' "$o" "$(opt_get "$o")"
    done
}

# Reads that back from stdin and puts back only what the reload actually moved.
restore_opts() {
    local o want
    while IFS=$'\t' read -r o want; do
        [[ -n $o && -n $want ]] || continue
        [[ $(opt_get "$o") == "$want" ]] && continue
        "$HLSET" "$o" "$want" >/dev/null
    done
}

# The runtime half of the lock: purple border, no mouse dragging, and for a
# browser the extra swallowed keys. Declared in hypr/lua/submaps.lua and called
# here so the bind list stays in the config where the rest of them are.
arm() {
    local class=$1 browser=false
    [[ $class =~ ^($BROWSERS) ]] && browser=true
    hyprctl eval "ZEN_ARM($browser)" >/dev/null
}

# Snaps focus back to the locked window. Runs detached; `zen off` kills it.
watch_focus() {
    echo $$ >"$WATCHPID"
    exec python3 - "$1" "$SELF" <<'PY'
import os, socket, subprocess, sys, time

locked, zen = sys.argv[1], sys.argv[2]
short = locked[2:] if locked.startswith("0x") else locked

path = os.path.join(os.environ["XDG_RUNTIME_DIR"], "hypr",
                    os.environ["HYPRLAND_INSTANCE_SIGNATURE"], ".socket2.sock")
sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.connect(path)

# Under the Lua config `hyprctl dispatch` takes a Lua expression, not the old
# "<dispatcher> <args>" pair.
refocus = ["hyprctl", "dispatch", 'hl.dsp.focus({window="address:%s"})' % locked]

recent, buf = [], b""
while True:
    data = sock.recv(4096)
    if not data:
        break
    buf += data
    while b"\n" in buf:
        raw, buf = buf.split(b"\n", 1)
        event, _, arg = raw.decode("utf-8", "replace").partition(">>")
        arg = arg.strip()
        if arg.startswith("0x"):
            arg = arg[2:]

        # The window went away — release the lock rather than trap him in a
        # mode whose anchor no longer exists. Detached, so `zen off` killing
        # this process cannot leave the release half-done.
        if event == "closewindow" and arg == short:
            subprocess.Popen([zen, "off"], start_new_session=True)
            sys.exit(0)

        # A reload put the config's binds back and dropped zen's runtime half;
        # re-arm it.
        if event == "configreloaded":
            time.sleep(0.3)
            subprocess.run([zen, "__rearm", locked],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            continue

        if event == "activewindowv2" and arg != short:
            # Always pull focus back — never skip one, or a steal would stick.
            # The backoff only exists so a window fighting for focus cannot
            # turn this into a spin.
            now = time.monotonic()
            recent = [t for t in recent if now - t < 2.0]
            if len(recent) >= 30:
                time.sleep(0.5)
                recent.clear()
            recent.append(now)
            subprocess.run(refocus,
                           stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
PY
}

# A reload rebuilds the submap from the config but throws away everything zen
# set at runtime. The watcher calls this back on every `configreloaded`.
rearm() {
    local addr=$1 class

    # zen is being torn down (`zen off` removes the state before it reloads);
    # re-arming here would fight the release.
    [[ -r $STATE ]] || return 0

    class=$(hyprctl clients -j | jq -r --arg a "$addr" \
        'first(.[] | select(.address == $a) | .class) // ""')
    arm "$class"

    # The reload flattened the runtime settings as well. Their live values are
    # already gone, so the snapshot zen took on the way in is all there is.
    { read -r _; read -r _; read -r _; restore_opts; } <"$STATE" 2>/dev/null || true
    red reapply
}

zen_on() {
    if [[ -r $STATE ]]; then
        echo "zen: already on" >&2
        return 0
    fi

    local win addr title class dnd
    win=$(hyprctl activewindow -j)
    addr=$(jq -r '.address // ""' <<<"$win")
    title=$(jq -r '.title // ""' <<<"$win")
    class=$(jq -r '.class // ""' <<<"$win")

    if [[ -z $addr || $addr == null ]]; then
        note "zen" "focus a window first — there is nothing to lock onto"
        echo "zen: no focused window to lock" >&2
        return 1
    fi

    dnd=$(swaync-client -D 2>/dev/null || echo false)
    note "zen on" "locked to $title"

    arm "$class"

    rm -f "$WATCHPID"
    setsid -f "$SELF" __watch "$addr" >/dev/null 2>&1

    command -v swaync-client >/dev/null && swaync-client -dn >/dev/null 2>&1
    { printf '%s\n%s\n%s\n' "$addr" "$dnd" "$title"; snapshot_opts; } >"$STATE"
}

zen_off() {
    if [[ ! -r $STATE ]]; then
        echo "zen: not on" >&2
        return 0
    fi

    local addr dnd title pid snap
    { read -r addr; read -r dnd; read -r title; } <"$STATE" || true
    # Taken live rather than from the state file, so a mode he switched during
    # zen is the one that survives leaving it.
    snap=$(snapshot_opts)
    rm -f "$STATE"

    # Checked against its cmdline first, so a recycled pid is never the one
    # that gets killed.
    if [[ -r $WATCHPID ]]; then
        read -r pid <"$WATCHPID"
        if [[ -n ${pid:-} ]] && grep -qa "$SELF" "/proc/$pid/cmdline" 2>/dev/null; then
            kill "$pid" 2>/dev/null
        fi
        rm -f "$WATCHPID"
    fi

    hyprctl dispatch 'hl.dsp.submap("reset")' >/dev/null
    # Re-reads the binds and the border colour from the config, and drops the
    # browser swallows and the mouse unbinds along the way.
    hyprctl reload config-only >/dev/null
    restore_opts <<<"$snap"
    red reapply

    # Only lift do-not-disturb if zen was what turned it on — dsa mode and pomo
    # use it too, and one of them may still be running.
    if [[ ${dnd:-false} != true ]] && command -v swaync-client >/dev/null; then
        swaync-client -df >/dev/null 2>&1
    fi

    note "zen off" "unlocked"
}

status() {
    if [[ -r $STATE ]]; then
        local addr dnd title
        { read -r addr; read -r dnd; read -r title; } <"$STATE" || true
        echo "on ${title:-?}"
    else
        echo "off"
    fi
}

case ${1:-} in
    '')       need_hypr; if [[ -r $STATE ]]; then zen_off; else zen_on; fi ;;
    on)       need_hypr; zen_on ;;
    off)      need_hypr; zen_off ;;
    status)   status ;;
    __watch)  watch_focus "${2:?}" ;;
    __rearm)  rearm "${2:?}" ;;
    *)        echo "usage: zen [on|off|status]" >&2; exit 2 ;;
esac
