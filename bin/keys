#!/usr/bin/env bash
# keys — searchable Hyprland keybind cheatsheet (Super+/).
# Enter runs the selected bind, Esc just closes.
#   keys --list   print the table to stdout instead of rofi
#
# This used to parse UserKeybinds.conf. Under the Lua config there is nothing
# useful left to parse: `hyprctl binds` reports every Lua bind's dispatcher as
# an opaque "__lua" handle, so the live bind table can neither describe a bind
# nor fire one. Instead every bind goes through util.bind in hypr/lua/util.lua,
# which records it in a KEYBINDS table inside the compositor, and this reads
# that back over hyprctl. Still live, so it still cannot go stale — and it now
# covers the default and laptop binds too, not just the personal ones.

set -u

THEME="$HOME/.config/rofi/themes/tokyonight-oled.rasi"

if ! command -v hyprctl >/dev/null || [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    echo "keys: needs a running Hyprland session" >&2
    exit 1
fi

# index \t combo \t description \t runnable
mapfile -t rows < <(hyprctl repl 'return KEYS_LIST()' 2>/dev/null)

if [[ ${#rows[@]} -eq 0 ]]; then
    echo "keys: the compositor returned no binds — is hypr/lua/util.lua loaded?" >&2
    exit 1
fi

display=()
ids=()
for row in "${rows[@]}"; do
    IFS=$'\t' read -r id combo desc runnable <<<"$row"
    [[ -n ${id:-} && -n ${combo:-} ]] || continue
    display+=("$(printf '%-26s %s' "$combo" "$desc")")
    [[ ${runnable:-0} == 1 ]] && ids+=("$id") || ids+=('')
done

if [[ ${1:-} == --list ]]; then
    printf '%s\n' "${display[@]}"
    exit 0
fi

idx=$(printf '%s\n' "${display[@]}" | rofi -dmenu -i -no-custom -p 'keybinds' -format i -theme "$THEME")
[[ -z ${idx:-} || $idx -lt 0 ]] && exit 0

id=${ids[$idx]}
[[ -n $id ]] && hyprctl eval "KEYS_RUN($id)" >/dev/null
